# Telegram bot tokeni (@BotFather dan olinadi)
BOT_TOKEN=

# Anthropic (Claude) API kaliti — test savollarini tuzish va o'quv dasturidan fanlarni ajratish uchun
ANTHROPIC_API_KEY=

# edu.profedu.uz akkauntingiz (faqat scrape.py uchun, fanlar ro'yxatini yuklab olishda)
PROFEDU_PHONE=+998 (90) 123-45-67
PROFEDU_PASSWORD=
# yoki parol o'rniga: brauzerda saytga kirib, "sessionid" cookie qiymatini qo'ying
PROFEDU_SESSIONID=

# Ixtiyoriy sozlamalar
CLAUDE_MODEL=claude-opus-5-5
DATA_FILE=data/fanlar_2026.json
DB_FILE=data/natijalar.sqlite3
# O'tish bali (foizda)
PASS_PERCENT=60

# Mini App: ommaviy HTTPS manzil (masalan https://bot.sizning-domen.uz/). Bo'sh bo'lsa faqat chat rejimi.
WEBAPP_URL=
WEB_HOST=0.0.0.0
WEB_PORT=8080
